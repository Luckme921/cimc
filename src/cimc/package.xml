<?xml version="1.0"?>
<package format="3">
  <name>cimc</name>
  <version>0.1.0</version>
  <description>ABB data receiver and eccentric welding-gun motor control nodes.</description>
  <maintainer email="luckme@todo.todo">luckme</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
